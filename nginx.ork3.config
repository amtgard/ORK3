server {
    listen 80;
    server_name _;

    root /var/www/ork.amtgard.com;
    index index.htm index.html index.php;

    add_header Access-Control-Allow-Origin *;

    # Trust Cloudflare proxies and use CF-Connecting-IP as the client IP.
    # IP ranges from https://www.cloudflare.com/ips/ — refresh occasionally.
    # Docker bridge range covers the host-side reverse proxy that fronts this container.
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 173.245.48.0/20;
    set_real_ip_from 103.21.244.0/22;
    set_real_ip_from 103.22.200.0/22;
    set_real_ip_from 103.31.4.0/22;
    set_real_ip_from 141.101.64.0/18;
    set_real_ip_from 108.162.192.0/18;
    set_real_ip_from 190.93.240.0/20;
    set_real_ip_from 188.114.96.0/20;
    set_real_ip_from 197.234.240.0/22;
    set_real_ip_from 198.41.128.0/17;
    set_real_ip_from 162.158.0.0/15;
    set_real_ip_from 104.16.0.0/13;
    set_real_ip_from 104.24.0.0/14;
    set_real_ip_from 172.64.0.0/13;
    set_real_ip_from 131.0.72.0/22;
    set_real_ip_from 2400:cb00::/32;
    set_real_ip_from 2606:4700::/32;
    set_real_ip_from 2803:f800::/32;
    set_real_ip_from 2405:b500::/32;
    set_real_ip_from 2405:8100::/32;
    set_real_ip_from 2a06:98c0::/29;
    set_real_ip_from 2c0f:f248::/32;
    real_ip_header CF-Connecting-IP;
    real_ip_recursive on;

    # Calendar (ICS) subscription feeds on a clean, stable path.
    # Deliberately kept off the ?Route= front controller so the CDN/WAF can
    # exempt automated calendar fetchers (Google Calendar, Apple Calendar,
    # Outlook) from the browser challenge with a simple URI-path match.
    # Those clients cannot execute JS, so a challenge silently empties the feed.
    location ^~ /ics/ {
        # Named capture on purpose: on the production build (nginx 1.18/Ubuntu with
        # extra dynamic modules loaded), the numbered $1 here resolved to a stale
        # capture from another regex ("/i" — the first chars of the URI) instead of
        # the kingdom id, truncating the route to Kingdom/ics/ and serving an empty
        # generic feed. $kid is scoped to this rewrite's own match and cannot bleed.
        # Diagnosed 2026-08-19 with a temporary $args access log; local containers
        # never reproduced it despite the identical nginx version and config.
        rewrite ^/ics/kingdom/(?<kid>[0-9]+)\.ics$ /orkui/index.php?Route=Kingdom/ics/$kid last;
        return 404;
    }

    # Sitemap at the conventional root path. The real sitemap is dynamic
    # (Controller_Sitemap: index + core + sharded players, 24h-cached); this
    # internal rewrite makes /sitemap.xml serve the index so crawlers and
    # tools that only probe the standard location find it. robots.txt carries
    # the same URL for explicit discovery. NOTE: nginx config is baked into
    # the image at build — this takes effect at the next green/blue rebuild.
    location = /sitemap.xml {
        rewrite ^ /orkui/index.php?Route=Sitemap last;
    }

    # Apple associated-domains file for mORK (Password AutoFill: lets iOS
    # offer the saved ork.amtgard.com password inside the app). Public by
    # design; lives at the repo root's .well-known/. No extension, so pin
    # the JSON content type Apple expects. Android's assetlinks.json would
    # sit beside it. Takes effect at the next image rebuild like the rest.
    location = /.well-known/apple-app-site-association {
        default_type application/json;
    }

    # Android Digital Asset Links for mORK (Google Password Manager: lets
    # Android offer the saved ork.amtgard.com password inside the app -- the
    # counterpart to the Apple file above). Same repo-root .well-known/ dir.
    # NOTE: production installs are signed by the Play App Signing key, so its
    # SHA-256 (Play Console -> Test and release -> App integrity -> App signing
    # key certificate) must be ADDED to assetlinks.json before Play-installed
    # users get autofill; the file currently carries only the upload + debug
    # keys. Takes effect at the next image rebuild like the rest.
    location = /.well-known/assetlinks.json {
        default_type application/json;
    }

    # --- CORS preflight -------------------------------------------------------
    # A browser-based client that sends a custom request header (mORK's WebView
    # sends X-Ork-Key from origin https://localhost) turns every call into a
    # "non-simple" cross-origin request: the browser first sends an OPTIONS
    # preflight and REFUSES to send the real request unless the response names
    # that header in Access-Control-Allow-Headers. Server-side callers (Lambda,
    # cron, curl) never hit this -- no browser is present to enforce it -- which
    # is how a header key can look "tested and working" while every WebView
    # client is hard-blocked with:
    #   "Request header field x-ork-key is not allowed by
    #    Access-Control-Allow-Headers in preflight response".
    #
    # Answered in nginx rather than PHP: a preflight carries no body and no
    # cookies and must be cheap. It also stops OPTIONS falling through to
    # index.php, which was answering it with the JSON service listing.
    #
    # REPEATED per location on purpose. add_header's context is
    # "http, server, location, if in location" -- NOT "if in server" -- so this
    # cannot be hoisted to the server block; nginx refuses to load that config.
    # And a location that declares its own add_header cancels inheritance of the
    # server-level Access-Control-Allow-Origin, so each copy restates it.
    #
    # NOTE: the Cloudflare rule "Allow CORS preflight (OPTIONS) on API paths"
    # must stay in place alongside this. A preflight carries no custom headers,
    # so the x-ork-key skip rules can never match it, and without that rule the
    # edge blocks the preflight before nginx ever sees it.
    location / {
        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin *;
            add_header Access-Control-Allow-Headers "X-Ork-Key, X-ORK-Client, Content-Type, Accept";
            add_header Access-Control-Allow-Methods "GET, POST, OPTIONS";
            add_header Access-Control-Max-Age 86400;
            add_header Content-Length 0;
            return 204;
        }
	try_files $uri $uri/ =404;
    }

    location ~ \.php$ {
        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin *;
            add_header Access-Control-Allow-Headers "X-Ork-Key, X-ORK-Client, Content-Type, Accept";
            add_header Access-Control-Allow-Methods "GET, POST, OPTIONS";
            add_header Access-Control-Max-Age 86400;
            add_header Content-Length 0;
            return 204;
        }
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/var/run/php/php8.1-fpm.sock;
    }

    # Scrollery certificate art — immutable, cached for a year.
    #
    # assets/scrolls/ is the frozen Arcanyst artwork plus the WebP renditions built
    # from it by bin/build-scroll-renditions.sh. It is immutable by construction:
    # path-addressed and never edited in place. Before this block it fell
    # through to the generic image rule below and was served
    # `max-age=300, must-revalidate` — so every print run more than five minutes stale
    # issued ~25 blocking conditional requests before the first pixel, which is exactly
    # what an officer printing a court in bursts on park wifi does not have time for.
    #
    # `^~` on purpose: it beats every regex location, so the 300-second image rule and
    # the .php handler can never claim a path under here.
    #
    # ESCAPE HATCH: if a file ever does change, append `?v=<token>` to its URL. The
    # token is the master's content hash, recorded per file as `sha` in
    # assets/scrolls/renditions.json. nginx ignores the query string when serving a
    # static file, so nothing here needs to change — the new URL is simply a new cache
    # key in every browser and proxy that holds the old one.
    location ^~ /assets/scrolls/ {
        # add_header at this level does not merge with the server-level
        # add_header Access-Control-Allow-Origin above — it REPLACES it. Re-assert it,
        # for the same reason the woff2 block below does. (The generic image rule that
        # used to serve this art has the same bug and has silently been dropping CORS
        # from every jpg/gif/png on the site; left alone here because fixing it is a
        # site-wide change, not a Scrollery one — noted in
        # docs/scrollery-asset-pipeline.md.)
        add_header Access-Control-Allow-Origin *;
        add_header Cache-Control "public, max-age=31536000, immutable";
        access_log off;
        try_files $uri =404;
    }

    # Compress SVG. gzip is `on` in nginx.conf but gzip_types there is commented out,
    # so nginx falls back to its built-in default of text/html ONLY — meaning the nine
    # SVG line-art files a certificate loads were being sent raw. Deliberately narrow:
    # widening this to CSS/JS/JSON is a site-wide change with its own blast radius.
    gzip_types image/svg+xml;
    gzip_vary on;
    gzip_min_length 512;

    # Generic site images. Short-lived on purpose — heraldry and player photos ARE
    # user-uploaded and mutable, so 300s revalidation is the right policy for them.
    #
    # The extension list previously read `\.(jpg|gif|png)` with no `$` anchor, which
    # left `.jpeg`, `.svg` and `.webp` with no Cache-Control header at all (verified
    # live: assets/scrolls/rose/burn.svg came back with none). `.webp` matters now that
    # the heraldry rendition pipeline and bin/build-scroll-renditions.sh both emit it.
    location ~* \.(jpe?g|gif|png|webp|svg|ico)$ {
        # Preflight, as above. Without this an OPTIONS for an image returns 405
        # from nginx's static handler (regex locations do not fall back to
        # `location /`), so a client that XHR-fetches heraldry or player photos
        # with X-Ork-Key is blocked even though the same file loads fine in an
        # <img> tag -- an <img> sends no custom header and so is never preflighted.
        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin *;
            add_header Access-Control-Allow-Headers "X-Ork-Key, X-ORK-Client, Content-Type, Accept";
            add_header Access-Control-Allow-Methods "GET, POST, OPTIONS";
            add_header Access-Control-Max-Age 86400;
            add_header Content-Length 0;
            return 204;
        }
        # ACAO is RESTATED here, not inherited. A location that declares any
        # add_header cancels every inherited one, so this block's Cache-Control
        # silently dropped the server-level Access-Control-Allow-Origin -- the
        # response still carried the image bytes, but a browser reading it via
        # XHR discarded them for CORS. That is invisible to <img> (no CORS) and
        # invisible to curl (not a browser); it only shows up in a client that
        # fetches images with XHR, which is exactly what a client must do once
        # it has to attach a credential header. Symptom: mORK showed its
        # placeholder avatar while the access log recorded 200s with real bytes.
        add_header Access-Control-Allow-Origin *;
        add_header Cache-Control "public, max-age=300, must-revalidate";
    }

    # Same restatement, same reason, for the other asset locations that set a
    # Cache-Control of their own.
    location ~* orkui.js {
        add_header Access-Control-Allow-Origin *;
        add_header Cache-Control "public, max-age=300, must-revalidate";
    }
    location ~* orkui.css {
        add_header Access-Control-Allow-Origin *;
        add_header Cache-Control "public, max-age=300, must-revalidate";
    }

    # woff2/woff MIME. Deferred item 3.8 — BUILT 2026-09-04 in 364c8580, and re-verified
    # live 2026-09-06: BlackChancery.woff2 returns `Content-Type: font/woff2` with
    # `max-age=2592000, immutable`. The base /etc/nginx/mime.types still has only
    # `application/font-woff woff` and no woff2 at all, which is why the local `types`
    # override below has to exist. Any font a future change adds is covered by the
    # extension match — nothing per-face to maintain.
    location ~* \.(woff2?)$ {
        types {
            font/woff2 woff2;
            font/woff  woff;
        }
        default_type font/woff2;
        # add_header at this level does not merge with the server-level
        # add_header Access-Control-Allow-Origin above — it replaces it.
        # Re-assert it here or cross-origin embeds (ork-schedule.js/demo.html)
        # lose webfont loading. Do not "clean up" this duplicate.
        add_header Access-Control-Allow-Origin *;
        add_header Cache-Control "public, max-age=2592000, immutable";
    }

    location = /fpm-status {
        allow 127.0.0.1;
        deny all;
        access_log off;
        fastcgi_pass unix:/var/run/php/php8.1-fpm.sock;
        fastcgi_param SCRIPT_FILENAME $fastcgi_script_name;
        include fastcgi_params;
    }
}