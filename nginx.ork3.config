server {
    listen 80;
    server_name _;

    root /var/www/ork.amtgard.com;
    index index.htm index.html index.php;

    add_header Access-Control-Allow-Origin *;

    # Trust Cloudflare proxies and use CF-Connecting-IP as the client IP.
    # IP ranges from https://www.cloudflare.com/ips/ — refresh occasionally.
    # Docker bridge range covers the host-side reverse proxy that fronts this container.
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 173.245.48.0/20;
    set_real_ip_from 103.21.244.0/22;
    set_real_ip_from 103.22.200.0/22;
    set_real_ip_from 103.31.4.0/22;
    set_real_ip_from 141.101.64.0/18;
    set_real_ip_from 108.162.192.0/18;
    set_real_ip_from 190.93.240.0/20;
    set_real_ip_from 188.114.96.0/20;
    set_real_ip_from 197.234.240.0/22;
    set_real_ip_from 198.41.128.0/17;
    set_real_ip_from 162.158.0.0/15;
    set_real_ip_from 104.16.0.0/13;
    set_real_ip_from 104.24.0.0/14;
    set_real_ip_from 172.64.0.0/13;
    set_real_ip_from 131.0.72.0/22;
    set_real_ip_from 2400:cb00::/32;
    set_real_ip_from 2606:4700::/32;
    set_real_ip_from 2803:f800::/32;
    set_real_ip_from 2405:b500::/32;
    set_real_ip_from 2405:8100::/32;
    set_real_ip_from 2a06:98c0::/29;
    set_real_ip_from 2c0f:f248::/32;
    real_ip_header CF-Connecting-IP;
    real_ip_recursive on;

    # Calendar (ICS) subscription feeds on a clean, stable path.
    # Deliberately kept off the ?Route= front controller so the CDN/WAF can
    # exempt automated calendar fetchers (Google Calendar, Apple Calendar,
    # Outlook) from the browser challenge with a simple URI-path match.
    # Those clients cannot execute JS, so a challenge silently empties the feed.
    location ^~ /ics/ {
        # Named capture on purpose: on the production build (nginx 1.18/Ubuntu with
        # extra dynamic modules loaded), the numbered $1 here resolved to a stale
        # capture from another regex ("/i" — the first chars of the URI) instead of
        # the kingdom id, truncating the route to Kingdom/ics/ and serving an empty
        # generic feed. $kid is scoped to this rewrite's own match and cannot bleed.
        # Diagnosed 2026-08-19 with a temporary $args access log; local containers
        # never reproduced it despite the identical nginx version and config.
        rewrite ^/ics/kingdom/(?<kid>[0-9]+)\.ics$ /orkui/index.php?Route=Kingdom/ics/$kid last;
        return 404;
    }

    location / {
	try_files $uri $uri/ =404;
    }

    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/var/run/php/php8.1-fpm.sock;
    }

    location ~* \.(jpg|gif|png) {
        add_header Cache-Control "public, max-age=300, must-revalidate";
    } 

    location ~* orkui.js {
        add_header Cache-Control "public, max-age=300, must-revalidate";
    } 
    location ~* orkui.css {
        add_header Cache-Control "public, max-age=300, must-revalidate";
    }

    location = /fpm-status {
        allow 127.0.0.1;
        deny all;
        access_log off;
        fastcgi_pass unix:/var/run/php/php8.1-fpm.sock;
        fastcgi_param SCRIPT_FILENAME $fastcgi_script_name;
        include fastcgi_params;
    }
}