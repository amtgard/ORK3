    "2026-08-27-zodiac-month.sql": { "class": "S", "render": "full", "notes": "Adds zodiac_month to ork_awards and ork_recommendations for Order of the Zodiac monthly tracking. Idempotent ADD COLUMN IF NOT EXISTS, no backfill; existing ranks unchanged." },
    "2026-08-28-recommendations-triage-columns.sql": { "class": "S", "render": "full", "notes": "Adds snoozed_by_id/passed_to_local to ork_recommendations. Both exist in prod via direct DB access but were never migrated; Kingdom::GetAdminDashboard() reads them in a raw DataSet(), so on a fresh build the query errors and the guard drops WaiveredMembers -- the Reset Waivers pre-count. Idempotent ADD COLUMN IF NOT EXISTS, no backfill." },
    // Moved 2026-08-29 out of an untracked top-level migrations/ directory. Nothing
    // scanned that directory -- not MigrationClassifier, not drift-check, not any deploy
    // script -- so the 8 files below were applied by hand and their tables never reached
    // rendered/sandbox.sql. The numeric 01..08 infix preserves dependency order, because
    // MigrationClassifier applies files in scandir+sort(SORT_STRING) order.
    "2026-08-25-01-rbac-tables.sql": { "class": "S", "render": "full", "notes": "Creates ork_role/ork_permission/ork_role_permission/ork_user_role/ork_rbac_audit. Idempotent CREATE TABLE IF NOT EXISTS." },
    "2026-08-25-02-rbac-seed.sql": { "class": "RC", "render": "full", "notes": "Seeds the role and permission catalog (10 roles, 59 permissions, 209 mappings). Reference data the app cannot boot RBAC without, so it renders. All INSERT IGNORE." },
    "2026-08-25-03-officer-history.sql": { "class": "S", "render": "full", "notes": "Creates ork_officer_history, read by class.Kingdom.php:1385 and class.Park.php:1240." },
    "2026-08-25-04-officer-position.sql": { "class": "S+RC", "render": "full", "notes": "Creates ork_officer_position(+_alias), seeds the 5 canonical positions, and maps existing officers onto them by role name. The UPDATEs key on role name, so they are correct against generated sandbox officers too." },
    "2026-08-25-05-officer-position-nesting.sql": { "class": "S", "render": "full", "notes": "Adds parent_position_id/hide_when_vacant. Superseded on fresh builds by 04's CREATE TABLE; kept for databases predating it. Made idempotent 2026-08-29 -- it previously aborted with a duplicate-column error, which is why this sequence never completed on dev." },
    "2026-08-25-06-officer-rbac-innodb.sql": { "class": "S", "render": "full", "notes": "Converts the officer/RBAC tables from MyISAM to InnoDB and adds idx_rbac_role. ENGINE=InnoDB on InnoDB is a no-op rebuild." },
    "2026-08-25-07-rbac-migrate-officers.sql": { "class": "PB", "render": "skip", "notes": "Derives ork_user_role rows from real officer records (2,506 on the prod mirror). Skipped in the render like every other backfill; a rendered sandbox gets the role CATALOG from 02 but no per-player assignments. Flagged deliberately -- if sandbox RBAC coverage is wanted later this becomes an override template." },
    "2026-08-25-08-qualtest-permissions.sql": { "class": "RC", "render": "full", "notes": "Adds the qualification-test permission and its role mappings. All INSERT IGNORE." },
    "2026-08-29-officer-position-alias-sort-order.sql": { "class": "S", "render": "full", "notes": "Adds sort_order INT NULL to ork_officer_position_alias -- the per-kingdom override for a SHARED (kingdom_id=0) position's order. Without it, reordering the Core Five writes rows all 37 kingdoms read. NULL means no override; resolved by OfficerPosition::SortOrderSql(). Idempotent ADD COLUMN IF NOT EXISTS, no backfill." }
