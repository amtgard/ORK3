{
    "$schema": "../../vendor/infection/infection/resources/schema.json",
    "timeout": 120,
    "source": {
        "directories": [
            "system/lib/ork3"
        ]
    },
    "logs": {
        "text": "build/infection-t12.log",
        "summary": "build/infection-t12-summary.log"
    },
    "mutators": {
        "@default": true
    },
    "minMsi": 49,
    "minCoveredMsi": 49,
    "testFramework": "phpunit",
    "bootstrap": "tests/bootstrap.php",
    "phpUnit": {
        "configDir": "../.."
    },
    "tmpDir": "build/infection-t12"
}
