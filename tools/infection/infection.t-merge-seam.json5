// PR #492 x #493 merge seam — scoped Infection for orkui/model/model.Event.php.
// The conflict-zone methods (_planning/_embed/_event_domain factories and
// get_event_summary_for_redirect) are pinned by tests/Unit/ModelEventMergeSeamTest.php.
// Run: sh bin/run-infection.sh --configuration=tools/infection/infection.t-merge-seam.json5 --filter=model.Event.php
{
    "$schema": "../../vendor/infection/infection/resources/schema.json",
    "timeout": 120,
    "source": {
        "directories": [
            "orkui/model"
        ]
    },
    "logs": {
        "text": "build/infection-t-merge-seam.log",
        "summary": "build/infection-t-merge-seam-summary.log"
    },
    "mutators": {
        "@default": true
    },
    "minMsi": 15,
    "minCoveredMsi": 15,
    "testFramework": "phpunit",
    "bootstrap": "tests/bootstrap.php",
    "phpUnit": {
        "configDir": "../.."
    },
    "tmpDir": "build/infection-t-merge-seam"
}
