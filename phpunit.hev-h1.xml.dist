<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/Unit/EnvFile/bootstrap.php"
         colors="true"
         cacheDirectory="build/phpunit-hev-h1-cache">
    <testsuites>
        <testsuite name="hev-h1">
            <file>tests/Unit/EnvFileTest.php</file>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <file>system/lib/system/class.EnvFile.php</file>
        </include>
    </source>
    <coverage>
        <report>
            <text outputFile="php://stdout" showUncoveredFiles="true"/>
        </report>
    </coverage>
</phpunit>
