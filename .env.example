# Non-secret configuration for local dev and gb deploy. Copy to .env (gitignored).
ENVIRONMENT=DEV
APP_STAGE=DEV
DB_HOSTNAME=mysql.example.com
DB_PORT=3306
DB_DATABASE=ork
DB_USERNAME=ork
ORK3_DB_HOST=ork3-php8-db
ORK3_DB_DATABASE=ork
ORK3_DB_USER=ork
ORK3_TEST_DB_HOST=127.0.0.1
ORK3_TEST_DB_PORT=19307
IDP_BASE_URL=http://localhost:37080
IDP_API_URL=http://host.docker.internal:37080
IDP_CLIENT_ID=ork3_dev
CACHE_HOST=ork-dev
CACHE_ENABLED=true
CF_ZONE_ID=
AMAZON_SES_HOST=email-smtp.us-east-1.amazonaws.com
AMAZON_SES_FROM_EMAIL=noreply@example.com
AMAZON_SES_PORT=587
ORK_DIST_NAME=
SETUP_ADMIN_EMAIL=you@example.com
HOST_ENV_SECRETS_DIR=/run/secrets
