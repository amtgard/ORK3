#!/bin/sh
#
# ORK3 shared pre-commit hook (versioned; activated via core.hooksPath=.githooks).
#
# Does three things:
#   1. Keeps the local-only class.Authorization.php (login-bypass override) out of every commit.
#   2. Auto-formats the PHP files you are committing to PSR-12 via tools/php-cs-fixer.phar.
#   3. Normalizes leading-tab indentation to spaces in the CSS/JS files you are committing,
#      via bin/normalize-leading-tabs.sh (POSIX awk only — no npm/node dependency).
#
# For (2) and (3): only files that are FULLY staged are touched — a file with both staged
# and unstaged changes is skipped, so unstaged hunks are never swept into the commit. The
# rewritten files are re-staged automatically.
#
# It never blocks a commit because of formatting (missing tools / errors only warn).

REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT" || exit 0

AUTH_FILE="system/lib/ork3/class.Authorization.php"

# ---------------------------------------------------------------------------
# 1. Never let class.Authorization.php content slip into a commit.
#    (Allow its removal from tracking via `git rm --cached`.)
# ---------------------------------------------------------------------------
if git diff --cached --name-only | grep -q "$AUTH_FILE"; then
    if git diff --cached --name-only --diff-filter=D | grep -q "$AUTH_FILE"; then
        echo "ℹ️  class.Authorization.php is being removed from tracking — allowed."
    else
        git reset -q HEAD "$AUTH_FILE"
        echo "⚠️  class.Authorization.php was unstaged automatically — it is excluded from all commits."
    fi
fi

# Echo only the FULLY-staged files from a newline-delimited list on stdin (drop
# any with lingering unstaged changes), warning about the partially-staged ones.
#   usage: <newline list> | fully_staged "<human label>"
fully_staged() {
    label=$1
    keep=""
    skipped=""
    OLDIFS=$IFS
    IFS='
'
    while read -r f; do
        [ -n "$f" ] || continue
        [ -f "$f" ] || continue
        if git diff --name-only -- "$f" | grep -q .; then
            skipped="$skipped $f"
        else
            keep="$keep
$f"
        fi
    done
    IFS=$OLDIFS
    [ -n "$skipped" ] && echo "ℹ️  Skipped $label (partially staged — fix & stage manually):$skipped" >&2
    printf '%s' "$keep" | sed '/^$/d'
}

# ---------------------------------------------------------------------------
# 2. PSR-12 auto-format staged PHP files (boy-scout: only what you touch).
# ---------------------------------------------------------------------------
format_php() {
    PHAR="tools/php-cs-fixer.phar"
    CONFIG=".php-cs-fixer.dist.php"

    PHP_BIN=$(command -v php 2>/dev/null)
    if [ -z "$PHP_BIN" ] || [ ! -f "$PHAR" ]; then
        [ -z "$PHP_BIN" ] && echo "ℹ️  php not found on PATH — skipping PHP auto-format (commit continues)."
        [ ! -f "$PHAR" ]  && echo "ℹ️  $PHAR missing — run 'npm install' or see tools/README.md (commit continues)."
        return 0
    fi

    STAGED_PHP=$(git diff --cached --name-only --diff-filter=ACM -- '*.php' | grep -v "^$AUTH_FILE$")
    [ -z "$STAGED_PHP" ] && return 0

    TO_FIX=$(printf '%s\n' "$STAGED_PHP" | fully_staged "PHP auto-format")
    [ -z "$TO_FIX" ] && return 0

    echo "$TO_FIX" | tr '\n' '\0' | \
        xargs -0 "$PHP_BIN" "$PHAR" fix --config="$CONFIG" --quiet --using-cache=yes
    if [ "$?" -ne 0 ]; then
        echo "⚠️  php-cs-fixer exited non-zero — committing your PHP files as-is (no auto-format applied)."
        return 0
    fi

    echo "$TO_FIX" | tr '\n' '\0' | xargs -0 git add --
    return 0
}

# ---------------------------------------------------------------------------
# 3. Normalize leading tabs -> spaces in staged CSS/JS (boy-scout).
#    Keeps committed assets off hard tabs so the Edit tooling stays reliable.
#    Minified/generated bundles (*.min.css, *.min.js) are excluded.
# ---------------------------------------------------------------------------
normalize_assets() {
    NORMALIZER="bin/normalize-leading-tabs.sh"
    if [ ! -f "$NORMALIZER" ]; then
        echo "ℹ️  $NORMALIZER missing — skipping CSS/JS tab-normalize (commit continues)."
        return 0
    fi

    STAGED_ASSETS=$(git diff --cached --name-only --diff-filter=ACM -- '*.css' '*.js' \
        | grep -vE '\.min\.(css|js)$')
    [ -z "$STAGED_ASSETS" ] && return 0

    TO_NORM=$(printf '%s\n' "$STAGED_ASSETS" | fully_staged "CSS/JS tab-normalize")
    [ -z "$TO_NORM" ] && return 0

    echo "$TO_NORM" | tr '\n' '\0' | xargs -0 sh "$NORMALIZER"
    if [ "$?" -ne 0 ]; then
        echo "⚠️  tab-normalize reported an error — committing your assets as-is."
        return 0
    fi

    echo "$TO_NORM" | tr '\n' '\0' | xargs -0 git add --
    return 0
}

format_php
normalize_assets
exit 0
