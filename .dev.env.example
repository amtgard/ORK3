# Copy to .dev.env for docker-compose.php8-app.dev.yml

# Flow A — ORK calls IDP on the shared Docker network (amtgard-idp-shared)
IDP_APP_URL=http://amtgard-idp
IDP_VALIDATE_SEND_NONCE_URL=http://amtgard-idp/resources/ork/validate-send-nonce
IDP_LINK_CLIENT_ID=
IDP_LINK_CLIENT_SECRET=
IDP_PROFILE_URL=http://localhost:37080/resources/profile

# SES SMTP — copy the same values from amtgard-idp .env (MAIL_TRANSPORT=ses uses these).
# AMAZON_SES_HOST=email-smtp.us-east-1.amazonaws.com
# AMAZON_SES_USERNAME=
# AMAZON_SES_PASSWORD=
# AMAZON_SES_FROM_EMAIL=
# AMAZON_SES_PORT=587
