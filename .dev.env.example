# Copy to .dev.env for docker-compose.php8-app.dev.yml
#
# Flow A IDP callback uses config.dev.php: IDP_API_URL, IDP_CLIENT_ID, IDP_CLIENT_SECRET.
# Mailed profile links use IDP_BASE_URL. Adjust those in config.dev.php if the container
# cannot reach the IDP via host.docker.internal (e.g. set IDP_API_URL=http://amtgard-idp).

# SES SMTP — copy the same values from amtgard-idp .env (MAIL_TRANSPORT=ses uses these).
# AMAZON_SES_HOST=email-smtp.us-east-1.amazonaws.com
# AMAZON_SES_USERNAME=
# AMAZON_SES_PASSWORD=
# AMAZON_SES_FROM_EMAIL=
# AMAZON_SES_PORT=587
